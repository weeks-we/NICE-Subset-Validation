# syntax=docker/dockerfile:1
# Company mirrors official vllm/vllm-openai:v0.22.0 and freezes the resolved digest.
ARG VLLM_BASE_IMAGE
FROM ${VLLM_BASE_IMAGE}
RUN python -c "import importlib.metadata as m; assert m.version('vllm') == '0.22.0'" \
    && python -m pip check \
    && python -m pip freeze > /opt/nice-vllm-environment-freeze.txt
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
COPY docs/reevaluation/vllm_policy.py /opt/nice-vllm-policy.py
ENTRYPOINT ["python", "/opt/nice-vllm-policy.py"]
# Models and original adapters are read-only mounts, never downloaded into this image.
# Keep vendor CUDA/PyTorch; the audited policy wrapper starts the same API server.
# Do NOT install original training locks here.
