# syntax=docker/dockerfile:1
# Build from repository root: docker build -f docs/reevaluation/Dockerfile.sdk ... .
# Separate SDK toolbox/smoke image. Use company's Python 3.12 Debian image pinned by digest.
ARG SDK_BASE_IMAGE
FROM ${SDK_BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git ripgrep ca-certificates libstdc++6 libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*
RUN getent passwd 1000 >/dev/null || useradd --uid 1000 --create-home --shell /bin/bash nice-agent
COPY docs/reevaluation/requirements-sdk.txt /tmp/nice-sdk-requirements.txt
RUN python -m venv /opt/nice-sdk \
    && /opt/nice-sdk/bin/python -m pip install --only-binary=:all: -r /tmp/nice-sdk-requirements.txt \
    && /opt/nice-sdk/bin/python -m pip check
ARG CLAUDE_SHA256
COPY docs/reevaluation/install_sdk_runtime.py /tmp/install_sdk_runtime.py
RUN CLAUDE_SHA256="${CLAUDE_SHA256}" /opt/nice-sdk/bin/python /tmp/install_sdk_runtime.py \
    && /opt/nice-sdk/bin/python -m pip freeze > /opt/nice-sdk/environment-freeze.txt
ENV DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# The SDK's bundled CLI is deliberately NOT selected. sdk_agent.py uses cli_path.
CMD ["/opt/nice-sdk/bin/python", "--version"]
